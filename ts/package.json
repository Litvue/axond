{
  "name": "axond-typescript",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test $(find packages -name '*.test.ts' -print)",
    "test:workerd": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test packages/worker/src/workerd.integration.ts",
    "lint:web": "node --experimental-strip-types scripts/lint-no-node-imports.ts",
    "check:alerts": "node --experimental-strip-types scripts/check-alerts.ts"
  },
  "engines": {
    "node": ">=22.14"
  }
}
