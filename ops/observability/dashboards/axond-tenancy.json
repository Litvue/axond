          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (axond_target_provider, axond_target_model) (rate(axond_upstream_errors{axond_namespace=~\"$namespace\", gen_ai_request_model=~\"$alias\", axond_target_provider=~\"$provider\", axond_target_model=~\"$target_model\"}[5m]))",
          "legendFormat": "{{axond_target_provider}}/{{axond_target_model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: first response",
          "url": "https://github.com/Litvue/axond/blob/main/docs/operations/observability-runbook.md#a-provider-target-is-out",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Gateway latency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, axond_namespace) (rate(axond_request_duration_bucket{axond_namespace=~\"$namespace\", gen_ai_request_model=~\"$alias\", axond_target_provider=~\"$provider\", axond_target_model=~\"$target_model\"}[10m])))",
          "legendFormat": "{{axond_namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: first response",
          "url": "https://github.com/Litvue/axond/blob/main/docs/operations/observability-runbook.md#served-errors-are-elevated",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Time to first token p95",
      "description": "The number streaming callers feel; provider degradation shows here first.",
