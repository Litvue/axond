        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (axond_namespace) (rate(axond_tokens_cache_write{axond_namespace=~\"$namespace\", gen_ai_request_model=~\"$alias\", axond_target_provider=~\"$provider\", axond_target_model=~\"$target_model\"}[5m]))",
          "legendFormat": "cache write {{axond_namespace}}",
          "range": true,
          "refId": "D"
        }
      ]
