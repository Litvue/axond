        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (axond_status) (rate(axond_request_count{axond_namespace=~\"$namespace\", gen_ai_request_model=~\"$alias\", axond_target_provider=~\"$provider\", axond_target_model=~\"$target_model\"}[5m]))",
          "legendFormat": "{{axond_status}}",
          "range": true,
          "refId": "A"
