          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(axond_request_time_to_first_token_bucket{axond_namespace=~\"$namespace\", gen_ai_request_model=~\"$alias\", axond_target_provider=~\"$provider\", axond_target_model=~\"$target_model\"}[10m])))",
          "legendFormat": "{{gen_ai_request_model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: first response",
          "url": "https://github.com/Litvue/axond/blob/main/docs/operations/observability-runbook.md#upstream-requests-are-timing-out",
          "targetBlank": true
