          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(axond_revision_converged) - min(axond_revision_converged)",
          "legendFormat": "convergence spread",
          "range": true,
          "refId": "B"
        }
