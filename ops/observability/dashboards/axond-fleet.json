      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(axond_rate_limit_unavailable_denials[5m]))",
          "legendFormat": "rate limit store",
          "range": true,
