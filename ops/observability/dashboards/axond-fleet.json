        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (axond_status_component) (axond_status_observation_age)",
          "legendFormat": "{{axond_status_component}}",
          "range": true,
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Runbook: first response",
          "url": "https://github.com/Litvue/axond/blob/main/docs/operations/observability-runbook.md#dependency-observations-have-gone-stale",
          "targetBlank": true
        }
