# Copy this file to .env before starting the quickstart:
#   cp ops/compose/env.example .env
#
# These values only need to be non-empty for boot. A real provider key is only
# needed for the chat/completions step; the health, readiness, and catalogue
# requests never leave the gateway.
#
# WARNING: the inbound values below are public examples. Replace them before
# exposing the gateway anywhere beyond your own machine.
# Optional Compose overrides:
#   AXOND_IMAGE=ghcr.io/litvue/axond:<version-or-digest>
#   AXOND_QUICKSTART_CONFIG=./ops/compose/axond.stateful.toml
#   AXOND_QUICKSTART_HOST_PORT=127.0.0.1:18080
# The smoke helper also accepts AXOND_QUICKSTART_SMOKE_PORT=18080.
GW_PLATFORM_OPENAI_API_KEY=placeholder-openai-key
GW_PLATFORM_ANTHROPIC_API_KEY=placeholder-anthropic-key
GW_ACME_OPENAI_API_KEY=placeholder-acme-openai-key
GW_INBOUND_PLATFORM_KEY=quickstart-platform-key
GW_INBOUND_ACME_KEY=quickstart-acme-key

# Stateful profile connection strings. Compose passes these to axond; the
# default configuration does not use them.
AXOND_BUDGET_REDIS_URL=redis://redis:6379
AXOND_RATE_LIMIT_REDIS_URL=redis://redis:6379
AXOND_USAGE_POSTGRES_DSN=postgres://postgres:axond-quickstart@postgres:5432/axond
