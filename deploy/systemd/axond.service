[Unit]
Description=Axond AI gateway
Documentation=https://github.com/Litvue/axond
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=axond
Group=axond
WorkingDirectory=/var/lib/axond
Environment=AXOND_CONFIG=/etc/axond/axond.toml
EnvironmentFile=/etc/axond/axond.env
ExecStart=/usr/local/bin/axond
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# One in-flight request costs a socket to the caller and one upstream, so the
# descriptor limit must exceed 2 x admission.max_in_flight with room for the
# listener, the config watch, and the store connections.
LimitNOFILE=65536
# A ceiling the kernel enforces if a bound is ever misconfigured: axond's own
# `[admission]` bounds are what should refuse work, and this is what keeps a
# breach of them from taking the host down with it. Size it above
# admission.max_in_flight x admission.max_request_bytes plus the process's
# steady-state footprint.
MemoryMax=2G
TasksMax=4096

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
