[Unit]
Description=Axond AI gateway
Documentation=https://github.com/Litvue/axond
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=axond
Group=axond
WorkingDirectory=/var/lib/axond
Environment=AXOND_CONFIG=/etc/axond/axond.toml
EnvironmentFile=/etc/axond/axond.env
ExecStart=/usr/local/bin/axond
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=65536

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
